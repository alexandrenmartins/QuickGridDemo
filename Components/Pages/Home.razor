@page "/"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridDemo.Models

<PageTitle>QuickGridDemo - Carros</PageTitle>

<div class="mt-2 d-flex justify-content-between align-items-baseline">
    <h3><b>Carros</b> - Lista de objetos em memória</h3>
    <h5>@QTD_ITENS_PER_PAGE itens por página</h5>
</div>

<QuickGrid Items="filteredCars" Class="table table-bordered table-hover" Pagination="paginationState">
    <PropertyColumn Property="@(x => x.Id)" Sortable="true" Title="ID"></PropertyColumn>
    <PropertyColumn Property="@(x => x.Model)" Sortable="true" Title="Modelo">
        <ColumnOptions>
            <input type="search" class="form-control" @bind="modelFilter" @bind:event="oninput" placeholder="Filtrar Modelo..." autofocus />
        </ColumnOptions>
    </PropertyColumn>
    <PropertyColumn Property="@(x => x.Manufacturer)" Title="Fabricante"></PropertyColumn>
    <PropertyColumn Property="@(x => x.Year)" Title="Ano"></PropertyColumn>
</QuickGrid>
<!-- Paginator Original com sumário de itens -->
@* <Paginator State="paginationState">
    <SummaryTemplate>
        <span>@paginationState.TotalItemCount itens</span>
    </SummaryTemplate> 
</Paginator> *@

<!-- Paginador customizado - INÍCIO -->
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <b>@QtdItens</b> itens
    </div>
    <div class="btn-group">
        <nav role="navigation" b-3qssc0bm46>
            <button class="go-first" title="Primeira página" @onclick="() => paginationState.SetCurrentPageIndexAsync(0)" disabled="@(!(paginationState.CurrentPageIndex > 0))" b-3qssc0bm46></button>
            <button class="go-previous" title="Página anterior" @onclick="PaginaAnterior" disabled="@(!(paginationState.CurrentPageIndex > 0))" b-3qssc0bm46></button>
            &nbsp;Pág. <b>@(paginationState.CurrentPageIndex + 1)</b> de <b>@TotalPaginas</b>&nbsp;
            <button class="go-next" title="Próxima página" @onclick="ProximaPagina" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))" b-3qssc0bm46></button>
            <button class="go-last" title="Última página" @onclick="() => paginationState.SetCurrentPageIndexAsync(TotalPaginas - 1)" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))" b-3qssc0bm46></button>
        </nav>
    </div>
</div>
<!-- Paginador customizado - FIM -->

@code {

    private const int QTD_ITENS_PER_PAGE = 5;

    // Paginador customizado
    #region PAGINADOR CUSTOMIZADO
    private int QtdItens => filteredCars.Count();
    private int TotalPaginas => (int)Math.Ceiling((double)QtdItens / QTD_ITENS_PER_PAGE);

    void PaginaAnterior() { if (paginationState.CurrentPageIndex > 0) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex - 1); }
    void ProximaPagina() { if (paginationState.CurrentPageIndex < TotalPaginas - 1) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex + 1); }
    #endregion

    IQueryable<Car> cars => new List<Car> {
        new Car { Id = 1, Manufacturer = "Toyota", Model = "Camry", Year = "2020" },
        new Car { Id = 2, Manufacturer = "Honda", Model = "Civic", Year = "2019" },
        new Car { Id = 3, Manufacturer = "Ford", Model = "Mustang", Year = "2021" },
        new Car { Id = 4, Manufacturer = "Chevrolet", Model = "Impala", Year = "2018" },
        new Car { Id = 5, Manufacturer = "Tesla", Model = "Model 3", Year = "2022" },
        new Car { Id = 6, Manufacturer = "Mercury", Model = "Cougar", Year = "1992"},
        new Car { Id = 7, Manufacturer = "BMW", Model = "X5", Year = "2021" },
        new Car { Id = 8, Manufacturer = "Audi", Model = "A4", Year = "2020" },
        new Car { Id = 9, Manufacturer = "Volkswagen", Model = "Golf", Year = "2019" },
        new Car { Id = 10, Manufacturer = "Hyundai", Model = "Elantra", Year = "2022" },
        new Car { Id = 11, Manufacturer = "Kia", Model = "Sorento", Year = "2021" },
        new Car { Id = 12, Manufacturer = "Nissan", Model = "Altima", Year = "2018" }


    }.AsQueryable();
    PaginationState paginationState = new PaginationState { ItemsPerPage = QTD_ITENS_PER_PAGE };
    string modelFilter = string.Empty;
    IQueryable<Car> filteredCars => cars.Where(c => c.Model.Contains(modelFilter, StringComparison.InvariantCultureIgnoreCase));
}
