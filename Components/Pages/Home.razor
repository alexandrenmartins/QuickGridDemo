@page "/"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridDemo.Models
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>QuickGridDemo - Carros</PageTitle>

<!-- Toast de sucesso -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
    @if (showToast)
    {
        <div class="toast show align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @((MarkupString)toastMessage)
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="HideToast"></button>
            </div>
        </div>
    }
</div>

<div class="mt-2 d-flex justify-content-between align-items-baseline">
    <h3><b>Carros</b> - Lista de objetos em memória</h3>
    <h5>@QTD_ITENS_PER_PAGE itens por página</h5>
</div>

<!-- Formulário para adicionar/editar Car -->
<div class="card my-3 p-3">
    <EditForm Model="newCar" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label">Fabricante</label>
                <InputText class="form-control" @bind-Value="newCar.Manufacturer" />
                <ValidationMessage For="() => newCar.Manufacturer" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Modelo</label>
                <InputText class="form-control" @bind-Value="newCar.Model" />
                <ValidationMessage For="() => newCar.Model" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ano</label>
                <InputText class="form-control" @bind-Value="newCar.Year" />
                <ValidationMessage For="() => newCar.Year" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn @(isEditing ? "btn-success" : "btn-primary")">
                    @(isEditing ? "Salvar" : "Adicionar")
                </button>
                @if (isEditing)
                {
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </div>
    </EditForm>
</div>

<QuickGrid Items="filteredCars" Class="table table-striped table-bordered table-hover" Pagination="paginationState">
    <PropertyColumn Property="@(x => x.Id)" Sortable="true" Title="ID"></PropertyColumn>
    <PropertyColumn Property="@(x => x.Model)" Sortable="true" Title="Modelo">
        <ColumnOptions>
            <input type="search" class="form-control" @bind="modelFilter" @bind:event="oninput" placeholder="Filtrar Modelo..." autofocus />
        </ColumnOptions>
    </PropertyColumn>
    <PropertyColumn Property="@(x => x.Manufacturer)" Title="Fabricante"></PropertyColumn>
    <PropertyColumn Property="@(x => x.Year)" Title="Ano"></PropertyColumn>
    <TemplateColumn Title="Ações">
        <button class="btn btn-primary btn-sm" @onclick="() => EditCar(context)">Editar</button>
        <button class="btn btn-danger btn-sm" @onclick="() => RequestDelete(context)">Excluir</button>
    </TemplateColumn>
</QuickGrid>

<!-- Modal de Confirmação de Exclusão -->
@if (showConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    Deseja realmente excluir o carro <b>@carToDelete?.Model</b> (@carToDelete?.Manufacturer)?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancela</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Confirma</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Paginador customizado - INÍCIO -->
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <b>@QtdItens</b> itens
    </div>
    <div class="btn-group">
        <nav role="navigation" b-3qssc0bm46>
            <button class="go-first" title="Primeira página" @onclick="() => paginationState.SetCurrentPageIndexAsync(0)" disabled="@(!(paginationState.CurrentPageIndex > 0))" b-3qssc0bm46></button>
            <button class="go-previous" title="Página anterior" @onclick="PaginaAnterior" disabled="@(!(paginationState.CurrentPageIndex > 0))" b-3qssc0bm46></button>
            &nbsp;Pág. <b>@(paginationState.CurrentPageIndex + 1)</b> de <b>@TotalPaginas</b>&nbsp;
            <button class="go-next" title="Próxima página" @onclick="ProximaPagina" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))" b-3qssc0bm46></button>
            <button class="go-last" title="Última página" @onclick="() => paginationState.SetCurrentPageIndexAsync(TotalPaginas - 1)" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))" b-3qssc0bm46></button>
        </nav>
    </div>
</div>
<!-- Paginador customizado - FIM -->

@code {

    private const int QTD_ITENS_PER_PAGE = 5;

    #region PAGINADOR CUSTOMIZADO
    private int QtdItens => filteredCars.Count();
    private int TotalPaginas => (int)Math.Ceiling((double)QtdItens / QTD_ITENS_PER_PAGE);

    void PaginaAnterior() { if (paginationState.CurrentPageIndex > 0) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex - 1); }
    void ProximaPagina() { if (paginationState.CurrentPageIndex < TotalPaginas - 1) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex + 1); }
    #endregion

    private List<Car> carsList = new List<Car> {
        new Car { Id = 1, Manufacturer = "Toyota", Model = "Camry", Year = "2020" },
        new Car { Id = 2, Manufacturer = "Honda", Model = "Civic", Year = "2019" },
        new Car { Id = 3, Manufacturer = "Ford", Model = "Mustang", Year = "2021" },
        new Car { Id = 4, Manufacturer = "Chevrolet", Model = "Impala", Year = "2018" },
        new Car { Id = 5, Manufacturer = "Tesla", Model = "Model 3", Year = "2022" },
        new Car { Id = 6, Manufacturer = "Mercury", Model = "Cougar", Year = "1992"},
        new Car { Id = 7, Manufacturer = "BMW", Model = "X5", Year = "2021" },
        new Car { Id = 8, Manufacturer = "Audi", Model = "A4", Year = "2020" },
        new Car { Id = 9, Manufacturer = "Volkswagen", Model = "Golf", Year = "2019" },
        new Car { Id = 10, Manufacturer = "Hyundai", Model = "Elantra", Year = "2022" },
        new Car { Id = 11, Manufacturer = "Kia", Model = "Sorento", Year = "2021" },
        new Car { Id = 12, Manufacturer = "Nissan", Model = "Altima", Year = "2018" },
        new Car { Id = 11, Manufacturer = "BMW", Model = "Z3", Year = "1996" },
        new Car { Id = 11, Manufacturer = "GM", Model = "Pontiac GTO", Year = "1964" }
    };

    IQueryable<Car> cars => carsList.AsQueryable();
    private Car newCar = new();
    PaginationState paginationState = new PaginationState { ItemsPerPage = QTD_ITENS_PER_PAGE };
    string modelFilter = string.Empty;
    IQueryable<Car> filteredCars => cars.Where(c => c.Model.Contains(modelFilter, StringComparison.InvariantCultureIgnoreCase));

    // Modal de confirmação de exclusão
    private bool showConfirmModal = false;
    private Car? carToDelete;

    // Estado de edição
    private bool isEditing = false;
    private Car? carToEdit;

    // Toast de sucesso
    private bool showToast = false;
    private string toastMessage = string.Empty;
    private CancellationTokenSource? toastCts;

    private void RequestDelete(Car car)
    {
        carToDelete = car;
        showConfirmModal = true;
    }

    private void ConfirmDelete()
    {
        if (carToDelete is not null)
        {
            carsList.Remove(carToDelete);
        }
        showConfirmModal = false;
        carToDelete = null;
    }

    private void CancelDelete()
    {
        showConfirmModal = false;
        carToDelete = null;
    }

    private void EditCar(Car car)
    {
        carToEdit = car;
        isEditing = true;
        newCar = new Car
        {
            Id = car.Id,
            Manufacturer = car.Manufacturer,
            Model = car.Model,
            Year = car.Year
        };
    }

    private void CancelEdit()
    {
        isEditing = false;
        carToEdit = null;
        newCar = new Car();
    }

    private void HandleValidSubmit()
    {
        if (isEditing)
            UpdateCar();
        else
            AddCar();
    }

    private void AddCar()
    {
        var nextId = carsList.Any() ? carsList.Max(c => c.Id) + 1 : 1;
        var carToAdd = new Car
        {
            Id = nextId,
            Manufacturer = newCar.Manufacturer ?? string.Empty,
            Model = newCar.Model ?? string.Empty,
            Year = newCar.Year ?? string.Empty
        };

        carsList.Add(carToAdd);
        ShowToast($"Carro <b>{carToAdd.Model} ({carToAdd.Manufacturer})</b> adicionado com sucesso!");
        newCar = new Car();
    }

    private void UpdateCar()
    {
        if (carToEdit is not null)
        {
            carToEdit.Manufacturer = newCar.Manufacturer ?? string.Empty;
            carToEdit.Model = newCar.Model ?? string.Empty;
            carToEdit.Year = newCar.Year ?? string.Empty;
            ShowToast($"Carro <b>{carToEdit.Model} ({carToEdit.Manufacturer})</b> alterado com sucesso!");
        }

        isEditing = false;
        carToEdit = null;
        newCar = new Car();
    }

    private async void ShowToast(string message)
    {
        toastCts?.Cancel();
        toastMessage = message;
        showToast = true;
        StateHasChanged();

        toastCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(3000, toastCts.Token);
            showToast = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void HideToast()
    {
        toastCts?.Cancel();
        showToast = false;
    }
}
