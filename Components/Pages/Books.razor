@page "/books"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridDemo.Models

@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>QuickGridDemo - Livros</PageTitle>

<h3><b>Livros</b> -  Api Web externa</h3>
<h5>@QTD_ITENS_PER_PAGE itens por página</h5>

<QuickGrid ItemsProvider="@gridItemsProvider" Virtualize="true" Class="table table-bordered table-hover" Pagination="paginationState">
    <PropertyColumn Property="@(x => x.Title)" Title="Título"></PropertyColumn>
    <PropertyColumn Property="@(x => x.First_Publish_Year)" Title="Ano"></PropertyColumn>
    <PropertyColumn Property="@(x => x.LanguageList)" Title="Idioma"></PropertyColumn>
    <PropertyColumn Property="@(x => x.AuthorsList)" Title="Autor(es)"></PropertyColumn>
</QuickGrid>
<Paginator State="paginationState"></Paginator>

@code {

    private const int QTD_ITENS_PER_PAGE = 10;

    private GridItemsProvider<Book>? gridItemsProvider;

    private PaginationState paginationState = new PaginationState { ItemsPerPage = QTD_ITENS_PER_PAGE };

    protected override void OnInitialized()
    {
        gridItemsProvider = async req =>
        {
            var url = Navigation.GetUriWithQueryParameters(
                "https://openlibrary.org/search.json",
                new Dictionary<string, object?>
                {
                    {"page", req.StartIndex + 1},
                    {"limit", req.Count},
                    {"title", "the sun"}
                }
            );

            try
            {
                using var response = await Http.GetFromJsonAsync<BookQueryResult>(url, req.CancellationToken);
                return GridItemsProviderResult.From(response.Docs, response.NumFound);
            }
            catch (Exception exc) { }

            return GridItemsProviderResult.From(new List<Book>(), 0);
        };
    }
}