@page "/customers"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridDemo.Models
@using QuickGridDemo.Data
@implements IAsyncDisposable
@inject IDbContextFactory<QuickGridDemo.Data.ApplicationDbContext> DbFactory

<PageTitle>QuickGridDemo - Customers from SQLite Database</PageTitle>

<h1>Customers from SQLite Database</h1>
<h5>@QTD_ITENS_PER_PAGE itens por página</h5>

<p>
    <a href="customers/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Customers" Pagination="paginationState">
    <PropertyColumn Property="customer => customer.CompanyName" Sortable="true"/>
    <PropertyColumn Property="customer => customer.ContactName" />
    <PropertyColumn Property="customer => customer.ContactTitle" />
    <PropertyColumn Property="customer => customer.Address" />
    <PropertyColumn Property="customer => customer.City" />
    <PropertyColumn Property="customer => customer.Region" />
   @*  <PropertyColumn Property="customer => customer.PostalCode" />
    <PropertyColumn Property="customer => customer.Country" />
    <PropertyColumn Property="customer => customer.Phone" />
    <PropertyColumn Property="customer => customer.Fax" /> *@

    <TemplateColumn Context="customer">
        <a href="@($"customers/edit?customerid={customer.CustomerID}")">Edit</a> |
        <a href="@($"customers/details?customerid={customer.CustomerID}")">Details</a> |
        <a href="@($"customers/delete?customerid={customer.CustomerID}")">Delete</a>
    </TemplateColumn>
</QuickGrid>
<!-- Paginator Original -->
@* <Paginator State="paginationState"></Paginator> *@

<!-- Paginador customizado - INÍCIO -->
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <b>@QtdItens</b> itens
    </div>
    <div class="btn-group">
        <nav role="navigation" b-3qssc0bm46>
            <button class="go-first" title="Primeira página" @onclick="() => paginationState.SetCurrentPageIndexAsync(0)" disabled="@(!(paginationState.CurrentPageIndex > 0))" b-3qssc0bm46></button>
            <button class="go-previous" title="Página anterior" @onclick="PaginaAnterior" disabled="@(!(paginationState.CurrentPageIndex > 0))" b-3qssc0bm46></button>
            &nbsp;Pág. <b>@(paginationState.CurrentPageIndex + 1)</b> de <b>@TotalPaginas</b>&nbsp;
            <button class="go-next" title="Próxima página" @onclick="ProximaPagina" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))" b-3qssc0bm46></button>
            <button class="go-last" title="Última página" @onclick="() => paginationState.SetCurrentPageIndexAsync(TotalPaginas - 1)" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))" b-3qssc0bm46></button>
        </nav>
    </div>
</div>
<!-- Paginador customizado - FIM -->

@code {

    private const int QTD_ITENS_PER_PAGE = 12;

    // Paginador customizado
    #region PAGINADOR CUSTOMIZADO
    private int QtdItens => context.Customers?.Count() ?? 0;
    private int TotalPaginas => (int)Math.Ceiling((double)QtdItens / QTD_ITENS_PER_PAGE);

    void PaginaAnterior() { if (paginationState.CurrentPageIndex > 0) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex - 1); }
    void ProximaPagina() { if (paginationState.CurrentPageIndex < TotalPaginas - 1) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex + 1); }
    #endregion

    private ApplicationDbContext context = default!;
    private PaginationState paginationState = new PaginationState { ItemsPerPage = QTD_ITENS_PER_PAGE };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
