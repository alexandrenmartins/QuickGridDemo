@page "/suppliers"﻿

@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using QuickGridDemo.Data
@using QuickGridDemo.Models

@implements IAsyncDisposable

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>QuickGridDemo - Suppliers from SQLite Database</PageTitle>

<h3>Suppliers from SQLite Database</h3>
<h5>@QTD_ITENS_PER_PAGE itens por página</h5>

<QuickGrid Items="filteredSuppliers" Pagination="paginationState" Class="table table-bordered table-hover">
    <PropertyColumn Property="@(x => x.SupplierID)" Title="ID" Sortable="true"></PropertyColumn>
    <PropertyColumn Property="@(x => x.CompanyName)" Title="Company Name" Sortable="true">
        <ColumnOptions>
            <input type="search" @bind="companyNameFilter" @bind:event="oninput" class="form-control" placeholder="Company Name..." />
        </ColumnOptions>
    </PropertyColumn>
    <PropertyColumn Property="@(x => x.ContactName)" Title="Contact Name">
        <ColumnOptions>
            <input type="search" @bind="contactNameFilter" @bind:event="oninput" class="form-control" placeholder="Contact Name..." />
        </ColumnOptions>
    </PropertyColumn>
    <PropertyColumn Property="@(x => x.ContactTitle)" Title="Contact Title"></PropertyColumn>
    <PropertyColumn Property="@(x => x.Address)"></PropertyColumn>
    <PropertyColumn Property="@(x => x.City)" Sortable="true"></PropertyColumn>
    <PropertyColumn Property="@(x => x.Region)"></PropertyColumn>
</QuickGrid>
<!-- Paginator Original -->
@* <Paginator State="paginationState"></Paginator> *@

<!-- Paginador customizado - INÍCIO -->
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <b>@_itensCount</b> itens
    </div>
    <div class="btn-group">
        <button class="btn btn-sm btn-outline-primary" @onclick="PrimeiraPagina" disabled="@(!(paginationState.CurrentPageIndex > 0))">Primeira</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="PaginaAnterior" disabled="@(!(paginationState.CurrentPageIndex > 0))">Anterior</button>
        &nbsp;Pág. @(paginationState.CurrentPageIndex + 1) de @TotalPaginas&nbsp;
        <button class="btn btn-sm btn-outline-primary" @onclick="ProximaPagina" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))">Próxima</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="UltimaPagina" disabled="@(!(paginationState.CurrentPageIndex < TotalPaginas - 1))">Última</button>
    </div>
</div>
<!-- Paginador customizado - FIM -->

@code {

    private const int QTD_ITENS_PER_PAGE = 10;

    // Paginador customizado
    #region PAGINADOR CUSTOMIZADO
    private int _itensCount => filteredSuppliers?.Count() ?? 0;

    int TotalPaginas => (int)Math.Ceiling((double)_itensCount / QTD_ITENS_PER_PAGE);

    void PrimeiraPagina() => paginationState.SetCurrentPageIndexAsync(0);
    void PaginaAnterior() { if (paginationState.CurrentPageIndex > 0) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex - 1); }
    void ProximaPagina() { if (paginationState.CurrentPageIndex < TotalPaginas - 1) paginationState.SetCurrentPageIndexAsync(paginationState.CurrentPageIndex + 1); }
    void UltimaPagina() => paginationState.SetCurrentPageIndexAsync(TotalPaginas - 1);
    #endregion

    private ApplicationDbContext dbContext = default!;
    private PaginationState paginationState = new PaginationState { ItemsPerPage = QTD_ITENS_PER_PAGE };

    // Variaveis para os campos dos filtros
    private string companyNameFilter = string.Empty, contactNameFilter = string.Empty;

    // Filtro para as colunas CompanyName e ContactName
    private IQueryable<Supplier>? filteredSuppliers => dbContext.Suppliers.Where(s => s.CompanyName.ToLower().Contains(companyNameFilter) &&
        s.ContactName.ToLower().Contains(contactNameFilter));

    protected override void OnInitialized()
    {
        dbContext = DbContextFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync()
    {
        await dbContext.DisposeAsync();
    }
}